{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "cSpell.words": [
    "bumpp",
    "composables",
    "devtool",
    "docsearch",
    "envinfo",
    "esbuild",
    "frontmatter",
    "globby",
    "gtag",
    "mdit",
    "ncurc",
    "nprogress",
    "oxfmt",
    "oxlint",
    "pacquet",
    "prefetch",
    "preload",
    "prismjs",
    "shiki",
    "shikiji",
    "slugify",
    "tsgolint",
    "unmount",
    "unrun",
    "verifyCommit",
    "vuejs",
    "vuepress",
    "vueuse",
    "zoomable"
  ]
}
