{
  "extends": "tsconfig-vuepress/base.json",
  "compilerOptions": {
    "lib": ["DOM", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "declaration": false,
    "skipLibCheck": true
  },
  "include": ["**/.vuepress/**/*", "oxfmt.config.ts"],
  "exclude": ["node_modules", ".cache", ".temp", "dist"]
}
