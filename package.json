{
  "name": "@vuepress/docs",
  "version": "2.0.0-rc.32",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "vue-tsc --noEmit",
    "docs:build": "vuepress build docs --clean-cache --clean-temp",
    "docs:build-webpack": "DOCS_BUNDLER=webpack pnpm docs:build",
    "docs:build-rspack": "DOCS_BUNDLER=rspack pnpm docs:build",
    "docs:clean": "rimraf docs/.vuepress/.temp docs/.vuepress/.cache docs/.vuepress/dist",
    "docs:dev": "vuepress dev docs --clean-cache --clean-temp",
    "docs:dev-webpack": "DOCS_BUNDLER=webpack pnpm docs:dev",
    "docs:dev-rspack": "DOCS_BUNDLER=rspack pnpm docs:dev",
    "docs:serve": "http-server docs/.vuepress/dist",
    "format": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "pkg:check-update": "pnpm dlx npm-check-updates",
    "pkg:update": "pnpm dlx npm-check-updates -u && pnpm install",
    "prepare": "husky",
    "release": "pnpm release:check && pnpm release:version",
    "release:check": "pnpm check-types && pnpm lint && pnpm docs:build",
    "release:version": "bumpp"
  },
  "dependencies": {
    "@vuepress/bundler-rspack": "2.0.0-rc.32",
    "@vuepress/bundler-vite": "2.0.0-rc.32",
    "@vuepress/bundler-webpack": "2.0.0-rc.32",
    "@vuepress/plugin-docsearch": "2.0.0-rc.141",
    "@vuepress/plugin-google-analytics": "2.0.0-rc.138",
    "@vuepress/plugin-register-components": "2.0.0-rc.138",
    "@vuepress/theme-default": "2.0.0-rc.141",
    "http-server": "^14.1.1",
    "vue": "^3.5.46",
    "vuepress": "2.0.0-rc.32"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@mr-hope/verify-commit-message": "0.1.1",
    "@vuepress/oxfmt-config": "^8.3.0",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "iconify-icon": "^3.0.5",
    "nano-staged": "^1.0.2",
    "oxc-config-hope": "^0.3.15",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "rimraf": "^6.1.4",
    "tsconfig-vuepress": "^7.0.0",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vue-tsc": "^3.3.14"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{cjs,js,ts,vue}": "oxlint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.23.4 || ^24.22.1 || ^26.13.1",
      "onFail": "error"
    }
  }
}
