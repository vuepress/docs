{
  "name": "@vuepress/docs",
  "version": "2.0.0-rc.26",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "vue-tsc --noEmit",
    "docs:build": "vuepress build docs --clean-cache --clean-temp",
    "docs:build-webpack": "DOCS_BUNDLER=webpack pnpm docs:build",
    "docs:clean": "rimraf docs/.vuepress/.temp docs/.vuepress/.cache docs/.vuepress/dist",
    "docs:dev": "vuepress dev docs --clean-cache --clean-temp",
    "docs:dev-webpack": "DOCS_BUNDLER=webpack pnpm docs:dev",
    "docs:serve": "http-server docs/.vuepress/dist",
    "format": "oxfmt",
    "lint": "eslint . && oxfmt --check",
    "prepare": "husky",
    "release": "pnpm release:check && pnpm release:version",
    "release:check": "pnpm check-types && pnpm lint && pnpm docs:build",
    "release:version": "bumpp"
  },
  "dependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/bundler-webpack": "2.0.0-rc.30",
    "@vuepress/plugin-docsearch": "2.0.0-rc.131",
    "@vuepress/plugin-google-analytics": "2.0.0-rc.130",
    "@vuepress/plugin-register-components": "2.0.0-rc.130",
    "@vuepress/plugin-shiki": "2.0.0-rc.131",
    "@vuepress/theme-default": "2.0.0-rc.131",
    "http-server": "^14.1.1",
    "sass-embedded": "^1.99.0",
    "sass-loader": "^16.0.8",
    "vue": "^3.5.34",
    "vuepress": "2.0.0-rc.30"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@vuepress/oxfmt-config": "^8.2.0",
    "bumpp": "^11.1.0",
    "eslint": "^9.39.4",
    "eslint-config-vuepress": "^7.1.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.49.0",
    "rimraf": "^6.1.3",
    "taze": "^19.12.0",
    "tsconfig-vuepress": "^7.0.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.2.9"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.(cjs|js|ts|vue)": "eslint --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.0.0 || ^26.0.0",
      "onFail": "error"
    }
  }
}
